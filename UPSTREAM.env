# Pins of the build (D-180, D-238, D-299). One value per line, read by the workflow.
# Changing a value = a pull request reviewed by the founder, then a new tag.

# matrix-rust-sdk tag matrix-sdk-crypto-0.19.1 (the version embedded in
# @matrix-org/matrix-sdk-crypto-wasm 18.9.0 used on the web): annotated tag object
# fcf65b419a541704d6a3ba32d5e1a52a4e434528, commit below.
UPSTREAM_REPOSITORY=matrix-org/matrix-rust-sdk
UPSTREAM_COMMIT=b18166c68bb958a21f0bca8b2d8320cb53583362

# Rust 1.99.0 (2026-10-01, at least 7 days old; workspace rust-version = 1.96).
RUST_VERSION=1.99.0
# SHA-256 of https://static.rust-lang.org/dist/channel-rust-1.99.0.toml (manifest dated 2026-10-01,
# identical to the published .sha256): the installed rustc, cargo and rust-std are checked against
# it (scripts/check-toolchain.py).
RUST_MANIFEST_SHA256=ce6dddc886364f8d786514771212cebe9b731ba82d6b859951c6b0ccc516b6a2
# cargo-ndk 4.1.2 (2025-08-09), installed with --locked.
CARGO_NDK_VERSION=4.1.2
# NDK preinstalled on ubuntu-24.04 runners, same as matrix-rust-components-kotlin.
NDK_VERSION=28.2.13676358

# Only the two architectures of real phones (no emulator, D-227).
TARGETS="aarch64-linux-android armv7-linux-androideabi"
