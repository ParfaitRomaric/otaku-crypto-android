+//! Primitives of the Otaku backup envelopes, for Android (Otaku ADR-0034, D-379).
+//!
+//! The web composes its backup envelopes (passphrase, recovery key, PIN escrow) from libsodium:
+//! Argon2id v1.3 (`crypto_pwhash`), XChaCha20-Poly1305 IETF
+//! (`crypto_aead_xchacha20poly1305_ietf_*`) and unkeyed BLAKE2b-256 (`crypto_generichash`).
+//! Android has neither WebAssembly nor these primitives in `javax.crypto`, so the same
+//! constructions are exported here, from the RustCrypto crates, with the same layout as libsodium
+//! (32-byte Argon2id output, 16-byte tag appended to the ciphertext). Nothing is implemented in
+//! this file: it only calls the standard constructions and checks their inputs.
+//!
+//! - Free functions, without an Olm machine nor a store.
+//! - Closed list of Argon2id parameter sets (Otaku ADR-0012 §2.2): the caller passes a set number
+//!   only, never a cost; a new set means a new patch and a new release.
+//! - Fixed error codes, no message of a library, nothing logged.
+//! - Every secret input, the derived key and the plaintext are erased when the function returns,
+//!   failure included (`Zeroizing`). The Argon2id work memory is reserved here (no abort on a
+//!   refused allocation) and erased before it is freed: `hash_password_into` of argon2 0.6.0
+//!   frees its own work memory without erasing it.
+//! - Known limit (as on the web): the values cross the UniFFI boundary in `RustBuffer` copies that
+//!   are not erased; the randomness (salt, nonce, keys) is drawn by the caller (Kotlin
+//!   `SecureRandom`), never here.
+
+use argon2::{Algorithm, Argon2, Block, Params, Version};
+use blake2::{Blake2b256, Digest};
+use chacha20poly1305::{AeadInOut, KeyInit, Tag, XChaCha20Poly1305, XNonce};
+use zeroize::{Zeroize, Zeroizing};
+
+/// Size of a key of XChaCha20-Poly1305, and of the Argon2id output.
+const KEY_BYTES: usize = 32;
+/// Size of an XChaCha20-Poly1305 nonce.
+const NONCE_BYTES: usize = 24;
+/// Size of the Poly1305 tag, appended to the ciphertext.
+const TAG_BYTES: usize = 16;
+/// Size of an Argon2id salt of the envelopes.
+const SALT_BYTES: usize = 16;
+/// Bounds of the password (UTF-8 of the NFKC passphrase), the same in the TypeScript of both sides.
+const MIN_PASSWORD_BYTES: usize = 1;
+const MAX_PASSWORD_BYTES: usize = 1024;
+/// Bound of a plaintext, ciphertext, associated data or hashed input: above the largest envelope
+/// of ADR-0012 (plaintext of 16 384 bytes, ciphertext of 16 400 bytes).
+const MAX_DATA_BYTES: usize = 32 * 1024;
+/// One lane, as libsodium.
+const LANES: u32 = 1;
+
+/// The fixed error codes of the backup primitives (closed list).
+#[derive(Debug, PartialEq, Eq, thiserror::Error, uniffi::Error)]
+#[uniffi(flat_error)]
+pub enum BackupPrimitiveError {
+    /// Unknown parameter set, salt or password out of bounds.
+    #[error("argon2_params")]
+    Argon2Params,
+    /// Key or nonce of the wrong size.
+    #[error("aead_input")]
+    AeadInput,
+    /// Tag, ciphertext or associated data altered, or wrong key: one code for all.
+    #[error("aead_open_failed")]
+    AeadOpenFailed,
+    /// An input above its bound.
+    #[error("input_too_large")]
+    InputTooLarge,
+    /// The work memory could not be reserved.
+    #[error("insufficient_memory")]
+    InsufficientMemory,
+    /// Anything else.
+    #[error("internal")]
+    Internal,
+}
+
+/// A set of the closed list: passes and memory in KiB (one lane).
+struct ParameterSet {
+    t_cost: u32,
+    m_cost_kib: u32,
+}
+
+/// The closed list of ADR-0012 §2.2, written here so that no caller can impose other values.
+fn parameter_set(id: u8) -> Option<ParameterSet> {
+    match id {
+        1 => Some(ParameterSet { t_cost: 3, m_cost_kib: 65_536 }),
+        2 => Some(ParameterSet { t_cost: 3, m_cost_kib: 131_072 }),
+        _ => None,
+    }
+}
+
+/// The work memory of Argon2id: reserved without aborting, erased before it is freed.
+struct WorkArea(Vec<Block>);
+
+impl WorkArea {
+    fn reserve(blocks: usize) -> Result<Self, BackupPrimitiveError> {
+        let mut memory = Vec::new();
+        memory.try_reserve_exact(blocks).map_err(|_| BackupPrimitiveError::InsufficientMemory)?;
+        // Within the reserved capacity: no reallocation, so no copy left behind.
+        memory.resize(blocks, Block::new());
+        Ok(Self(memory))
+    }
+
+    fn wipe(&mut self) {
+        for block in self.0.iter_mut() {
+            block.zeroize();
+        }
+    }
+}
+
+impl Drop for WorkArea {
+    fn drop(&mut self) {
+        self.wipe();
+    }
+}
+
+/// Argon2id into `out` with the work memory `area`, erased afterwards whatever the result.
+fn argon2id_into(
+    argon2: &Argon2<'_>,
+    password: &[u8],
+    salt: &[u8],
+    out: &mut [u8],
+    area: &mut WorkArea,
+) -> Result<(), BackupPrimitiveError> {
+    let result =
+        argon2.hash_password_into_with_memory(password, salt, out, area.0.as_mut_slice());
+    area.wipe();
+    result.map_err(|_| BackupPrimitiveError::Internal)
+}
+
+/// Argon2id v1.3 of `password` (UTF-8 of the NFKC passphrase, 1 to 1 024 bytes) and `salt`
+/// (16 bytes) with the set `kdf_set` of the closed list (1 or 2): the 32-byte key.
+#[matrix_sdk_ffi_macros::export]
+pub fn backup_argon2id(
+    password: Vec<u8>,
+    salt: Vec<u8>,
+    kdf_set: u8,
+) -> Result<Vec<u8>, BackupPrimitiveError> {
+    let password = Zeroizing::new(password);
+    let set = parameter_set(kdf_set).ok_or(BackupPrimitiveError::Argon2Params)?;
+    if salt.len() != SALT_BYTES
+        || !(MIN_PASSWORD_BYTES..=MAX_PASSWORD_BYTES).contains(&password.len())
+    {
+        return Err(BackupPrimitiveError::Argon2Params);
+    }
+    let params = Params::new(set.m_cost_kib, set.t_cost, LANES, Some(KEY_BYTES))
+        .map_err(|_| BackupPrimitiveError::Internal)?;
+    let argon2 = Argon2::new(Algorithm::Argon2id, Version::V0x13, params);
+    let mut area = WorkArea::reserve(argon2.params().block_count())?;
+    let mut key = Zeroizing::new([0u8; KEY_BYTES]);
+    argon2id_into(&argon2, &password, &salt, key.as_mut_slice(), &mut area)?;
+    Ok(key.to_vec())
+}
+
+fn cipher_of<'n>(
+    key: &[u8],
+    nonce: &'n [u8],
+) -> Result<(XChaCha20Poly1305, &'n XNonce), BackupPrimitiveError> {
+    if key.len() != KEY_BYTES || nonce.len() != NONCE_BYTES {
+        return Err(BackupPrimitiveError::AeadInput);
+    }
+    let cipher =
+        XChaCha20Poly1305::new_from_slice(key).map_err(|_| BackupPrimitiveError::AeadInput)?;
+    let nonce: &XNonce = nonce.try_into().map_err(|_| BackupPrimitiveError::AeadInput)?;
+    Ok((cipher, nonce))
+}
+
+fn buffer_with(bytes: &[u8], extra: usize) -> Result<Zeroizing<Vec<u8>>, BackupPrimitiveError> {
+    let mut buffer = Zeroizing::new(Vec::new());
+    buffer
+        .try_reserve_exact(bytes.len() + extra)
+        .map_err(|_| BackupPrimitiveError::InsufficientMemory)?;
+    buffer.extend_from_slice(bytes);
+    Ok(buffer)
+}
+
+/// XChaCha20-Poly1305 IETF: the ciphertext with its 16-byte tag appended (libsodium's
+/// `crypto_aead_xchacha20poly1305_ietf_encrypt`). The nonce is drawn by the caller, fresh for
+/// every sealing.
+#[matrix_sdk_ffi_macros::export]
+pub fn backup_seal(
+    key: Vec<u8>,
+    nonce: Vec<u8>,
+    plaintext: Vec<u8>,
+    aad: Vec<u8>,
+) -> Result<Vec<u8>, BackupPrimitiveError> {
+    let key = Zeroizing::new(key);
+    let plaintext = Zeroizing::new(plaintext);
+    let (cipher, nonce) = cipher_of(&key, &nonce)?;
+    if plaintext.len() > MAX_DATA_BYTES || aad.len() > MAX_DATA_BYTES {
+        return Err(BackupPrimitiveError::InputTooLarge);
+    }
+    let mut buffer = buffer_with(&plaintext, TAG_BYTES)?;
+    let tag = cipher
+        .encrypt_inout_detached(nonce, &aad, buffer.as_mut_slice().into())
+        .map_err(|_| BackupPrimitiveError::Internal)?;
+    buffer.extend_from_slice(&tag);
+    Ok(std::mem::take(&mut *buffer))
+}
+
+/// Opens what `backup_seal` produced (libsodium's
+/// `crypto_aead_xchacha20poly1305_ietf_decrypt`): no output unless the tag is authentic.
+#[matrix_sdk_ffi_macros::export]
+pub fn backup_open(
+    key: Vec<u8>,
+    nonce: Vec<u8>,
+    ciphertext: Vec<u8>,
+    aad: Vec<u8>,
+) -> Result<Vec<u8>, BackupPrimitiveError> {
+    let key = Zeroizing::new(key);
+    let (cipher, nonce) = cipher_of(&key, &nonce)?;
+    if ciphertext.len() > MAX_DATA_BYTES || aad.len() > MAX_DATA_BYTES {
+        return Err(BackupPrimitiveError::InputTooLarge);
+    }
+    let Some(body_len) = ciphertext.len().checked_sub(TAG_BYTES) else {
+        return Err(BackupPrimitiveError::AeadOpenFailed);
+    };
+    let (body, tag) = ciphertext.split_at(body_len);
+    let tag: &Tag = tag.try_into().map_err(|_| BackupPrimitiveError::Internal)?;
+    let mut buffer = buffer_with(body, 0)?;
+    cipher
+        .decrypt_inout_detached(nonce, &aad, buffer.as_mut_slice().into(), tag)
+        .map_err(|_| BackupPrimitiveError::AeadOpenFailed)?;
+    Ok(std::mem::take(&mut *buffer))
+}
+
+/// Unkeyed BLAKE2b with a 32-byte output (libsodium's `crypto_generichash(32, data, NULL)`): the
+/// check of the recovery key.
+#[matrix_sdk_ffi_macros::export]
+pub fn backup_blake2b256(data: Vec<u8>) -> Result<Vec<u8>, BackupPrimitiveError> {
+    let data = Zeroizing::new(data);
+    if data.len() > MAX_DATA_BYTES {
+        return Err(BackupPrimitiveError::InputTooLarge);
+    }
+    Ok(Blake2b256::digest(data.as_slice()).to_vec())
+}
+
+#[cfg(test)]
+mod tests {
+    //! Blocking for every release of the binding (ADR-0034 §5, §8): the official vectors of each
+    //! construction, then the Otaku fixtures of the web (the same bytes, checked by SHA-256), which
+    //! must give exactly what libsodium gives.
+
+    use argon2::{AssociatedData, ParamsBuilder};
+    use blake2::Blake2b512;
+    use serde_json::Value;
+    use sha2::Sha256;
+
+    use super::*;
+
+    const SECRETS: &[u8] = include_bytes!("../fixtures/otaku/secrets-envelope-v1.json");
+    const RECOVERY: &[u8] = include_bytes!("../fixtures/otaku/recovery-envelope-v1.json");
+    const PIN_ESCROW: &[u8] = include_bytes!("../fixtures/otaku/pin-escrow-envelope-v1.json");
+    // SHA-256 of packages/crypto/fixtures/*.json of the Otaku repository (same bytes).
+    const SECRETS_SHA256: &str =
+        "eeaaa02fe0c02ac509f9f515a2f59d96fdb4192b80cfc56f49fb11bd305a9b16";
+    const RECOVERY_SHA256: &str =
+        "c76d60e57967b215bda99f73663aa66bde4788d2f88a88a1fd900711f942c613";
+    const PIN_ESCROW_SHA256: &str =
+        "ec3badc63edd6c5bb72a187940cc902ba76165736b6ee1e8d692b2cf2e661285";
+
+    fn hex(text: &str) -> Vec<u8> {
+        assert!(text.len() % 2 == 0, "odd hex length");
+        (0..text.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&text[i..i + 2], 16).expect("hex"))
+            .collect()
+    }
+
+    fn to_hex(bytes: &[u8]) -> String {
+        bytes.iter().map(|b| format!("{b:02x}")).collect()
+    }
+
+    /// Unpadded base64url of the fixtures (test helper only).
+    fn base64url(text: &str) -> Vec<u8> {
+        let mut bits: u32 = 0;
+        let mut count = 0u32;
+        let mut out = Vec::new();
+        for c in text.bytes() {
+            let value = match c {
+                b'A'..=b'Z' => c - b'A',
+                b'a'..=b'z' => c - b'a' + 26,
+                b'0'..=b'9' => c - b'0' + 52,
+                b'-' => 62,
+                b'_' => 63,
+                _ => panic!("not base64url"),
+            };
+            bits = (bits << 6) | u32::from(value);
+            count += 6;
+            if count >= 8 {
+                count -= 8;
+                out.push((bits >> count) as u8);
+                bits &= (1 << count) - 1;
+            }
+        }
+        out
+    }
+
+    fn fixture(bytes: &[u8], sha256: &str) -> Value {
+        assert_eq!(to_hex(&Sha256::digest(bytes)), sha256, "fixture differs from the web's");
+        serde_json::from_slice(bytes).expect("fixture JSON")
+    }
+
+    fn text<'a>(value: &'a Value, key: &str) -> &'a str {
+        value[key].as_str().unwrap_or_else(|| panic!("missing {key}"))
+    }
+
+    fn envelope(case: &Value) -> Value {
+        serde_json::from_str(text(case, "envelopeText")).expect("envelope JSON")
+    }
+
+    fn uuid_bytes(id: &str) -> Vec<u8> {
+        hex(&id.replace('-', ""))
+    }
+
+    /// Byte i = (from + step × i) mod 256 (rule of the PIN escrow fixture).
+    fn rule_bytes(rule: &Value) -> Vec<u8> {
+        let from = rule["from"].as_i64().expect("from");
+        let step = rule["step"].as_i64().expect("step");
+        (0..32).map(|i| (from + step * i).rem_euclid(256) as u8).collect()
+    }
+
+    fn secrets_ad(set_id: u8, account_id: &str) -> Vec<u8> {
+        let set = parameter_set(set_id).expect("set of the list");
+        let mut ad = b"OTAKU-SECRETS-ENVELOPE".to_vec();
+        ad.extend_from_slice(&[1, 1, set_id]);
+        ad.extend_from_slice(&set.t_cost.to_be_bytes());
+        ad.extend_from_slice(&set.m_cost_kib.to_be_bytes());
+        ad.extend_from_slice(&LANES.to_be_bytes());
+        ad.extend_from_slice(&[1, 16]);
+        ad.extend_from_slice(&uuid_bytes(account_id));
+        ad
+    }
+
+    fn recovery_ad(account_id: &str) -> Vec<u8> {
+        let mut ad = b"OTAKU-RECOVERY-ENVELOPE".to_vec();
+        ad.extend_from_slice(&[1, 1, 16]);
+        ad.extend_from_slice(&uuid_bytes(account_id));
+        ad
+    }
+
+    fn pin_escrow_ad(account_id: &str, generation: u64) -> Vec<u8> {
+        let mut ad = b"OTAKU-PIN-ESCROW-ENVELOPE".to_vec();
+        ad.extend_from_slice(&[1, 1, 16]);
+        ad.extend_from_slice(&uuid_bytes(account_id));
+        ad.extend_from_slice(&generation.to_be_bytes());
