+    #[test]
+    fn secrets_envelope_fixtures() {
+        let fixture = fixture(SECRETS, SECRETS_SHA256);
+        let mut saw_set_2 = false;
+        let mut saw_maximum = false;
+        for case in cases(&fixture, "valid") {
+            let set_id = case["parameterSetId"].as_u64().expect("set") as u8;
+            let ad = hex(text(case, "associatedDataHex"));
+            assert_eq!(ad, secrets_ad(set_id, text(case, "accountId")), "{}", text(case, "name"));
+            let key = backup_argon2id(
+                hex(text(case, "normalisedPassphraseUtf8Hex")),
+                hex(text(case, "saltHex")),
+                set_id,
+            )
+            .expect("derive");
+            assert_eq!(key.len(), 32);
+            assert_eq!(to_hex(&key), text(case, "derivedKeyHex"), "{}", text(case, "name"));
+            let ciphertext = base64url(text(&envelope(case), "ciphertext"));
+            let plaintext = text(case, "plaintext").as_bytes().to_vec();
+            let nonce = hex(text(case, "nonceHex"));
+            let sealed =
+                backup_seal(key.clone(), nonce.clone(), plaintext.clone(), ad.clone()).expect("seal");
+            assert_eq!(sealed, ciphertext, "{}", text(case, "name"));
+            assert_eq!(backup_open(key, nonce, ciphertext, ad).expect("open"), plaintext);
+            saw_set_2 |= set_id == 2;
+            saw_maximum |= plaintext.len() == 16_384 && sealed.len() == 16_400;
+        }
+        // A valid case of set 2 (m = 131 072 KiB) catches a KiB/bytes confusion; the largest
+        // envelope of ADR-0012 must pass too.
+        assert!(saw_set_2, "no valid case of set 2");
+        assert!(saw_maximum, "no maximum-size case");
+
+        for case in cases(&fixture, "wrongPassphrase") {
+            let parsed = envelope(case);
+            let set_id = parsed["kdf"]["set"].as_u64().expect("set") as u8;
+            let key = backup_argon2id(
+                hex(text(case, "passphraseUtf8Hex")),
+                base64url(text(&parsed["kdf"], "salt")),
+                set_id,
+            )
+            .expect("derive");
+            let opened = backup_open(
+                key,
+                base64url(text(&parsed, "nonce")),
+                base64url(text(&parsed, "ciphertext")),
+                secrets_ad(set_id, text(case, "accountId")),
+            );
+            assert_eq!(opened, Err(BackupPrimitiveError::AeadOpenFailed), "{}", text(case, "name"));
+        }
+
+        // The invalid envelopes that reach a primitive: a salt or a nonce of the wrong size. Only
+        // those are parsed: the other invalid texts are not JSON at all (NaN, BOM, truncated...).
+        let password = hex(text(&cases(&fixture, "valid")[0], "normalisedPassphraseUtf8Hex"));
+        let mut reached = 0;
+        for case in cases(&fixture, "invalid") {
+            let name = text(case, "name");
+            match name {
+                "salt-15-bytes" | "salt-17-bytes" => {
+                    let parsed = envelope(case);
+                    assert_eq!(
+                        backup_argon2id(
+                            password.clone(),
+                            base64url(text(&parsed["kdf"], "salt")),
+                            1
+                        ),
+                        Err(BackupPrimitiveError::Argon2Params),
+                        "{name}"
+                    );
+                    reached += 1;
+                }
+                "nonce-12-bytes" | "nonce-25-bytes" => {
+                    let parsed = envelope(case);
+                    assert_eq!(
+                        backup_open(
+                            vec![0; 32],
+                            base64url(text(&parsed, "nonce")),
+                            base64url(text(&parsed, "ciphertext")),
+                            Vec::new()
+                        ),
+                        Err(BackupPrimitiveError::AeadInput),
+                        "{name}"
+                    );
+                    reached += 1;
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(reached, 4, "the four invalid cases that reach a primitive");
+    }
