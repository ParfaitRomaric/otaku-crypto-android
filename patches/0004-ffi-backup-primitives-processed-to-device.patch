+    /// RFC 9106 §5.3: Argon2id v1.3 with a secret and associated data, through the same work area
+    /// as the exported function (the exported API takes neither).
+    #[test]
+    fn argon2id_rfc9106_section_5_3() {
+        let params = ParamsBuilder::new()
+            .m_cost(32)
+            .t_cost(3)
+            .p_cost(4)
+            .output_len(32)
+            .data(AssociatedData::new(&[0x04; 12]).expect("ad"))
+            .build()
+            .expect("params");
+        let secret = [0x03u8; 8];
+        let argon2 = Argon2::new_with_secret(&secret, Algorithm::Argon2id, Version::V0x13, params)
+            .expect("context");
+        let mut area = WorkArea::reserve(argon2.params().block_count()).expect("memory");
+        let mut out = [0u8; 32];
+        argon2id_into(&argon2, &[0x01; 32], &[0x02; 16], &mut out, &mut area).expect("hash");
+        assert_eq!(
+            to_hex(&out),
+            "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"
+        );
+    }
