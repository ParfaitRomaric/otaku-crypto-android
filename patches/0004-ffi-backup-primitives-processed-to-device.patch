+    /// The same to-device events as `to_device_events`, in the same order,
+    /// with what the machine knows of each: whether it was encrypted, by
+    /// which device, and the verification state of that device.
+    processed_to_device_events: Vec<ProcessedToDeviceEvent>,
+}
+
+/// A to-device event after it has been processed by the [`OlmMachine`]
+/// (`matrix_sdk_common::deserialized_responses::ProcessedToDeviceEvent`).
+#[derive(uniffi::Enum)]
+pub enum ProcessedToDeviceEvent {
+    /// A successfully decrypted Olm event.
+    Decrypted {
+        /// The decrypted event, serialized.
+        raw: String,
+        /// The user ID of the sender; untrusted unless `verification_state` is
+        /// `verified`.
+        sender: String,
+        /// The device ID of the sending device, if known; untrusted unless
+        /// `verification_state` is `verified`.
+        sender_device: Option<String>,
+        /// The Curve25519 key of the sending device (base64), if Olm.
+        sender_curve25519_key: Option<String>,
+        /// `verified`, or one of the fixed names of the verification levels
+        /// (`unverified_identity`, `verification_violation`, `unsigned_device`,
+        /// `missing_device`, `insecure_source`, `mismatched_sender`).
+        verification_state: String,
+    },
+    /// An encrypted event that could not be decrypted.
+    UnableToDecrypt {
+        /// A fixed code: `decryption_failure`, `unverified_sender_device`,
+        /// `no_olm_machine` or `encryption_is_disabled`.
+        reason: String,
+    },
+    /// An event that was not encrypted, serialized.
+    PlainText {
+        /// The event, serialized.
+        raw: String,
+    },
+    /// An event ignored because it was invalid.
+    Invalid,
+}
+
+impl From<&SdkProcessedToDeviceEvent> for ProcessedToDeviceEvent {
+    fn from(event: &SdkProcessedToDeviceEvent) -> Self {
+        match event {
+            SdkProcessedToDeviceEvent::Decrypted { raw, encryption_info } => Self::Decrypted {
+                raw: raw.json().get().to_owned(),
+                sender: encryption_info.sender.to_string(),
+                sender_device: encryption_info.sender_device.as_ref().map(ToString::to_string),
+                sender_curve25519_key: match &encryption_info.algorithm_info {
+                    AlgorithmInfo::OlmV1Curve25519AesSha2 { curve25519_public_key_base64 } => {
+                        Some(curve25519_public_key_base64.clone())
+                    }
+                    _ => None,
+                },
+                verification_state: match &encryption_info.verification_state {
+                    VerificationState::Verified => "verified".to_owned(),
+                    VerificationState::Unverified(level) => {
+                        verification_level_name(level).to_owned()
+                    }
+                },
+            },
+            SdkProcessedToDeviceEvent::UnableToDecrypt { utd_info, .. } => Self::UnableToDecrypt {
+                reason: match utd_info.reason {
+                    ToDeviceUnableToDecryptReason::DecryptionFailure => "decryption_failure",
+                    ToDeviceUnableToDecryptReason::UnverifiedSenderDevice => {
+                        "unverified_sender_device"
+                    }
+                    ToDeviceUnableToDecryptReason::NoOlmMachine => "no_olm_machine",
+                    ToDeviceUnableToDecryptReason::EncryptionIsDisabled => "encryption_is_disabled",
+                }
+                .to_owned(),
+            },
+            SdkProcessedToDeviceEvent::PlainText(raw) => {
+                Self::PlainText { raw: raw.json().get().to_owned() }
+            }
+            SdkProcessedToDeviceEvent::Invalid(_) => Self::Invalid,
+        }
+    }
 }
 
