+    // ---- Refusals and bounds ----
+
+    #[test]
+    fn argon2id_refuses_what_is_out_of_the_list() {
+        let salt = vec![7u8; 16];
+        let ok_password = b"x".to_vec();
+        for set in [0u8, 3, 255] {
+            assert_eq!(
+                backup_argon2id(ok_password.clone(), salt.clone(), set),
+                Err(BackupPrimitiveError::Argon2Params)
+            );
+        }
+        for bad_salt in [vec![7u8; 15], vec![7u8; 17], Vec::new()] {
+            assert_eq!(
+                backup_argon2id(ok_password.clone(), bad_salt, 1),
+                Err(BackupPrimitiveError::Argon2Params)
+            );
+        }
+        assert_eq!(
+            backup_argon2id(Vec::new(), salt.clone(), 1),
+            Err(BackupPrimitiveError::Argon2Params)
+        );
+        assert_eq!(
+            backup_argon2id(vec![b'a'; 1025], salt.clone(), 1),
+            Err(BackupPrimitiveError::Argon2Params)
+        );
+        // Both bounds themselves are accepted, with an output of exactly 32 bytes.
+        assert_eq!(backup_argon2id(ok_password, salt.clone(), 1).expect("1 byte").len(), 32);
+        assert_eq!(backup_argon2id(vec![b'a'; 1024], salt, 1).expect("1 024 bytes").len(), 32);
+    }
+
+    #[test]
+    fn aead_refusals() {
+        let key = vec![1u8; 32];
+        let nonce = vec![2u8; 24];
+        let sealed = backup_seal(key.clone(), nonce.clone(), b"secret".to_vec(), b"ad".to_vec())
+            .expect("seal");
+        assert_eq!(sealed.len(), 6 + 16);
+
+        assert_eq!(
+            backup_seal(vec![1; 31], nonce.clone(), Vec::new(), Vec::new()),
+            Err(BackupPrimitiveError::AeadInput)
+        );
+        assert_eq!(
+            backup_seal(key.clone(), vec![2; 23], Vec::new(), Vec::new()),
+            Err(BackupPrimitiveError::AeadInput)
+        );
+        assert_eq!(
+            backup_open(key.clone(), vec![2; 25], sealed.clone(), b"ad".to_vec()),
+            Err(BackupPrimitiveError::AeadInput)
+        );
+        assert_eq!(
+            backup_seal(key.clone(), nonce.clone(), vec![0; MAX_DATA_BYTES + 1], Vec::new()),
+            Err(BackupPrimitiveError::InputTooLarge)
+        );
+        assert_eq!(
+            backup_seal(key.clone(), nonce.clone(), Vec::new(), vec![0; MAX_DATA_BYTES + 1]),
+            Err(BackupPrimitiveError::InputTooLarge)
+        );
+        assert_eq!(
+            backup_open(key.clone(), nonce.clone(), vec![0; MAX_DATA_BYTES + 1], Vec::new()),
+            Err(BackupPrimitiveError::InputTooLarge)
+        );
+        assert_eq!(
+            backup_blake2b256(vec![0; MAX_DATA_BYTES + 1]),
+            Err(BackupPrimitiveError::InputTooLarge)
+        );
+        // Every alteration gives the same single code, and no output.
+        for i in 0..sealed.len() {
+            let mut altered = sealed.clone();
+            altered[i] ^= 1;
+            assert_eq!(
+                backup_open(key.clone(), nonce.clone(), altered, b"ad".to_vec()),
+                Err(BackupPrimitiveError::AeadOpenFailed)
+            );
+        }
+        assert_eq!(
+            backup_open(key.clone(), nonce.clone(), sealed.clone(), b"aD".to_vec()),
+            Err(BackupPrimitiveError::AeadOpenFailed)
+        );
+        assert_eq!(
+            backup_open(vec![9; 32], nonce.clone(), sealed.clone(), b"ad".to_vec()),
+            Err(BackupPrimitiveError::AeadOpenFailed)
+        );
+        assert_eq!(
+            backup_open(key.clone(), nonce.clone(), sealed[..15].to_vec(), b"ad".to_vec()),
+            Err(BackupPrimitiveError::AeadOpenFailed)
+        );
+        assert_eq!(
+            backup_open(key, nonce, sealed, b"ad".to_vec()).expect("open"),
+            b"secret".to_vec()
+        );
+    }
+
+    // ---- Work memory ----
+
+    fn dirty(area: &mut WorkArea) {
+        for (i, block) in area.0.iter_mut().enumerate() {
+            let words: &mut [u64] = block.as_mut();
+            for word in words.iter_mut() {
+                *word = 0xa5a5_a5a5_0000_0000 | i as u64;
+            }
+        }
+    }
+
+    fn is_wiped(area: &WorkArea) -> bool {
+        area.0.iter().all(|block| {
+            let words: &[u64] = block.as_ref();
+            words.iter().all(|word| *word == 0)
+        })
+    }
+
+    #[test]
+    fn work_memory_is_erased_on_success_and_on_failure() {
+        let params = Params::new(64, 1, 1, Some(32)).expect("params");
+        let argon2 = Argon2::new(Algorithm::Argon2id, Version::V0x13, params);
+        let mut area = WorkArea::reserve(argon2.params().block_count()).expect("memory");
+        assert_eq!(area.0.len(), 64);
+
+        let mut out = [0u8; 32];
+        argon2id_into(&argon2, b"password", &[1; 16], &mut out, &mut area).expect("hash");
+        assert!(is_wiped(&area), "not erased after a success");
+        assert_ne!(out, [0u8; 32]);
+
+        // Failure after the reservation (salt below the crate's minimum): erased too.
+        dirty(&mut area);
+        assert!(!is_wiped(&area));
+        assert_eq!(
+            argon2id_into(&argon2, b"password", &[1; 4], &mut out, &mut area),
+            Err(BackupPrimitiveError::Internal)
+        );
+        assert!(is_wiped(&area), "not erased after a failure");
+    }
+
+    /// `wipe` erases every block, and `Drop` calls it: a work area left by any path (an early
+    /// return, a panic unwinding) is erased before it is freed. The memory cannot be read once
+    /// freed, so the call itself is checked in the source.
+    #[test]
+    fn wipe_erases_every_block_and_drop_calls_it() {
+        let mut area = WorkArea::reserve(8).expect("memory");
+        dirty(&mut area);
+        assert!(!is_wiped(&area));
+        area.wipe();
+        assert!(is_wiped(&area));
+        let source = include_str!("backup_primitives.rs");
+        let drop_impl = &source[source.find("impl Drop for WorkArea").expect("Drop")..];
+        let body = &drop_impl[..drop_impl.find("\n}\n").expect("end of impl")];
+        assert!(body.contains("fn drop(&mut self) {\n        self.wipe();\n    }"), "Drop must wipe");
+    }
+
+    #[test]
+    fn refused_reservation_is_insufficient_memory_not_an_abort() {
+        assert!(matches!(
+            WorkArea::reserve(usize::MAX / Block::SIZE),
+            Err(BackupPrimitiveError::InsufficientMemory)
+        ));
+    }
+
+    // ---- Exported surface ----
+
+    /// `kdf_set` is the only cost parameter of the exported API: exactly four exported functions
+    /// in this file, with these signatures (no variant taking t, m or p).
+    #[test]
+    fn exported_surface_is_the_closed_list() {
+        let source = include_str!("backup_primitives.rs");
+        let production = &source[..source.find("#[cfg(test)]").expect("tests")];
+        let exported: Vec<String> = production
+            .split("#[matrix_sdk_ffi_macros::export]")
+            .skip(1)
+            .map(|rest| {
+                let signature = &rest[..rest.find('{').expect("body")];
+                signature.split_whitespace().collect::<Vec<_>>().join(" ")
+            })
+            .collect();
+        assert_eq!(
+            exported,
+            vec![
+                "pub fn backup_argon2id( password: Vec<u8>, salt: Vec<u8>, kdf_set: u8, ) -> Result<Vec<u8>, BackupPrimitiveError>",
+                "pub fn backup_seal( key: Vec<u8>, nonce: Vec<u8>, plaintext: Vec<u8>, aad: Vec<u8>, ) -> Result<Vec<u8>, BackupPrimitiveError>",
+                "pub fn backup_open( key: Vec<u8>, nonce: Vec<u8>, ciphertext: Vec<u8>, aad: Vec<u8>, ) -> Result<Vec<u8>, BackupPrimitiveError>",
+                "pub fn backup_blake2b256(data: Vec<u8>) -> Result<Vec<u8>, BackupPrimitiveError>",
+            ]
+        );
+        assert!(!production.contains("uniffi::export"), "export through the crate's macro only");
+    }
+}
