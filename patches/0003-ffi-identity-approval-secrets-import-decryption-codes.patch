+    /// Approve the current identity of another user: its master key becomes
+    /// the pinned one (`OtherUserIdentity::pin_current_master_key`).
+    pub fn pin_current_master_key(&self, user_id: String) -> Result<(), SignatureError> {
+        let user_id = UserId::parse(user_id)?;
+
+        match self.runtime.block_on(self.inner.get_identity(&user_id, None))? {
+            Some(SdkUserIdentity::Other(i)) => Ok(self.runtime.block_on(i.pin_current_master_key())?),
+            _ => Err(SignatureError::UnknownUserIdentity(user_id.to_string())),
+        }
+    }
+
+    /// Withdraw the verification requirement of another user whose verified
+    /// identity changed (`OtherUserIdentity::withdraw_verification`).
+    pub fn withdraw_verification(&self, user_id: String) -> Result<(), SignatureError> {
+        let user_id = UserId::parse(user_id)?;
+
+        match self.runtime.block_on(self.inner.get_identity(&user_id, None))? {
+            Some(SdkUserIdentity::Other(i)) => Ok(self.runtime.block_on(i.withdraw_verification())?),
+            _ => Err(SignatureError::UnknownUserIdentity(user_id.to_string())),
+        }
+    }
