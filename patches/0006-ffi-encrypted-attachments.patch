@@ -0,0 +1,328 @@
+//! Encrypted attachments of the messaging of Otaku, for Android (Otaku D-381, ADR-0029 §10;
+//! release otaku.5).
+//!
+//! The web encrypts a photo or a voice message with `Attachment.encrypt` and opens it with
+//! `Attachment.decrypt` of matrix-sdk-crypto-wasm. The UniFFI bindings have no such call, so the
+//! same two are exported here, over the same types of matrix-sdk-crypto: `AttachmentEncryptor`
+//! (fresh random key and IV, AES-256-CTR, SHA-256 of the ciphertext) and `AttachmentDecryptor`
+//! (`EncryptedFile` v2 only, SHA-256 checked at the end of the data). Nothing is implemented in
+//! this file: it only feeds bytes to those types and checks the sizes.
+//!
+//! - Free functions, without an Olm machine nor a store.
+//! - The media encryption info crosses as the JSON of `MediaEncryptionInfo` (serde of the library,
+//!   the shape the wasm bindings give and take).
+//! - Fixed error codes, no message of a library, nothing logged.
+//! - The clear input of `attachment_encrypt`, the info text of `attachment_decrypt` and a clear
+//!   refused by the hash check are erased when the function returns (`Zeroizing`).
+//! - Known limit (as on the web): the values cross the UniFFI boundary in `RustBuffer` copies that
+//!   are not erased, and the key held by `AttachmentEncryptor` / `AttachmentDecryptor` is not
+//!   erased by the library when they are dropped.
+
+use std::io::{Cursor, Read};
+
+use matrix_sdk_crypto::{AttachmentDecryptor, AttachmentEncryptor, MediaEncryptionInfo};
+use zeroize::Zeroizing;
+
+/// Largest attachment, clear or encrypted (CHAT_MEDIA_CEILING_BYTES of Otaku: 25 MiB, every kind
+/// of media included, later ones too).
+const MAX_ATTACHMENT_BYTES: usize = 25 * 1024 * 1024;
+/// Largest media encryption info accepted (the real one is about 250 bytes).
+const MAX_INFO_BYTES: usize = 4096;
+
+/// The fixed error codes of the attachments (closed list).
+#[derive(Debug, PartialEq, Eq, thiserror::Error, uniffi::Error)]
+#[uniffi(flat_error)]
+pub enum AttachmentError {
+    /// Empty data, or data above the bound.
+    #[error("attachment_input")]
+    Input,
+    /// The media encryption info does not read (JSON, version other than v2, no SHA-256, a key
+    /// or an IV of the wrong size).
+    #[error("attachment_info")]
+    Info,
+    /// The SHA-256 of the encrypted data is not the one of the info: no output.
+    #[error("attachment_corrupted")]
+    Corrupted,
+    /// The output could not be reserved.
+    #[error("insufficient_memory")]
+    InsufficientMemory,
+    /// Anything else.
+    #[error("internal")]
+    Internal,
+}
+
+/// An attachment encrypted by `attachment_encrypt`.
+#[derive(uniffi::Record)]
+pub struct EncryptedAttachment {
+    /// The encrypted bytes, as many as the clear ones.
+    pub encrypted_data: Vec<u8>,
+    /// The JSON of `MediaEncryptionInfo` (`v`, `key`, `iv`, `hashes`): it holds the key.
+    pub media_encryption_info: String,
+}
+
+fn check_size(len: usize) -> Result<(), AttachmentError> {
+    if len == 0 || len > MAX_ATTACHMENT_BYTES { Err(AttachmentError::Input) } else { Ok(()) }
+}
+
+fn reserved<T>(len: usize) -> Result<Vec<T>, AttachmentError> {
+    let mut buffer = Vec::new();
+    buffer.try_reserve_exact(len).map_err(|_| AttachmentError::InsufficientMemory)?;
+    Ok(buffer)
+}
+
+/// Encrypts `data` with a fresh key and IV (`Attachment.encrypt` of the wasm bindings).
+#[matrix_sdk_ffi_macros::export]
+pub fn attachment_encrypt(data: Vec<u8>) -> Result<EncryptedAttachment, AttachmentError> {
+    let data = Zeroizing::new(data);
+    check_size(data.len())?;
+    let mut reader = Cursor::new(data.as_slice());
+    let mut encryptor = AttachmentEncryptor::new(&mut reader);
+    // Within the reserved capacity: the clear read into it is encrypted in place, never copied.
+    let mut encrypted = Zeroizing::new(reserved::<u8>(data.len())?);
+    encryptor.read_to_end(&mut encrypted).map_err(|_| AttachmentError::Internal)?;
+    if encrypted.len() != data.len() {
+        return Err(AttachmentError::Internal);
+    }
+    let info = encryptor.finish();
+    let info = Zeroizing::new(serde_json::to_string(&info).map_err(|_| AttachmentError::Internal)?);
+    Ok(EncryptedAttachment {
+        encrypted_data: std::mem::take(&mut *encrypted),
+        media_encryption_info: info.as_str().to_owned(),
+    })
+}
+
+/// Decrypts what `attachment_encrypt` (or any Matrix client) produced, given its media encryption
+/// info (`Attachment.decrypt` of the wasm bindings): no output unless the SHA-256 of the encrypted
+/// data is the one of the info.
+#[matrix_sdk_ffi_macros::export]
+pub fn attachment_decrypt(
+    encrypted_data: Vec<u8>,
+    media_encryption_info: String,
+) -> Result<Vec<u8>, AttachmentError> {
+    let info_text = Zeroizing::new(media_encryption_info);
+    check_size(encrypted_data.len())?;
+    if info_text.len() > MAX_INFO_BYTES {
+        return Err(AttachmentError::Info);
+    }
+    let info: MediaEncryptionInfo =
+        serde_json::from_str(&info_text).map_err(|_| AttachmentError::Info)?;
+    let mut reader = Cursor::new(encrypted_data.as_slice());
+    let mut decryptor =
+        AttachmentDecryptor::new(&mut reader, info).map_err(|_| AttachmentError::Info)?;
+    let mut clear = Zeroizing::new(reserved::<u8>(encrypted_data.len())?);
+    // The hash is checked when the reader reaches the end: an error then, and the clear already
+    // written is erased with `clear`.
+    decryptor.read_to_end(&mut clear).map_err(|_| AttachmentError::Corrupted)?;
+    if clear.len() != encrypted_data.len() {
+        return Err(AttachmentError::Internal);
+    }
+    Ok(std::mem::take(&mut *clear))
+}
+
+#[cfg(test)]
+mod tests {
+    //! Blocking for every release of the binding: the common vectors of Otaku (computed by
+    //! node:crypto, read by the web and by the Android adapter too: the same bytes, checked by
+    //! SHA-256), the round trip, every refusal, and the exported surface.
+
+    use serde_json::Value;
+    use sha2::{Digest, Sha256};
+    use vodozemac::{base64_decode, base64_encode};
+
+    use super::*;
+
+    const VECTORS: &[u8] = include_bytes!("../fixtures/otaku/attachment-v2.json");
+    // SHA-256 of packages/crypto/fixtures/attachment-v2.json of the Otaku repository (same bytes).
+    const VECTORS_SHA256: &str =
+        "c9855d9cb93ab53aa3bd9e55b573884e8c57d19b5e526c0bc80df8ea99c8dd20";
+
+    fn hex(text: &str) -> Vec<u8> {
+        assert!(text.len() % 2 == 0, "odd hex length");
+        (0..text.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&text[i..i + 2], 16).expect("hex"))
+            .collect()
+    }
+
+    fn to_hex(bytes: &[u8]) -> String {
+        bytes.iter().map(|b| format!("{b:02x}")).collect()
+    }
+
+    fn vectors() -> Vec<Value> {
+        assert_eq!(to_hex(&Sha256::digest(VECTORS)), VECTORS_SHA256, "fixture differs from the web's");
+        let fixture: Value = serde_json::from_slice(VECTORS).expect("fixture JSON");
+        assert_eq!(fixture["format"], "otaku.attachment-vectors");
+        assert_eq!(fixture["version"], 1);
+        let vectors = fixture["vectors"].as_array().expect("vectors").clone();
+        assert_eq!(vectors.len(), 4, "every vector of the fixture is read");
+        vectors
+    }
+
+    fn text<'a>(value: &'a Value, key: &str) -> &'a str {
+        value[key].as_str().unwrap_or_else(|| panic!("missing {key}"))
+    }
+
+    fn info_of(vector: &Value) -> String {
+        serde_json::to_string(&vector["mediaEncryptionInfo"]).expect("info")
+    }
+
+    // ---- Common vectors of Otaku (node:crypto) ----
+
+    #[test]
+    fn decrypts_every_common_vector() {
+        for vector in vectors() {
+            let name = text(&vector, "name");
+            let clear = attachment_decrypt(hex(text(&vector, "ciphertextHex")), info_of(&vector))
+                .unwrap_or_else(|e| panic!("{name}: {e}"));
+            assert_eq!(to_hex(&clear), text(&vector, "clearHex"), "{name}");
+            assert_eq!(base64_encode(Sha256::digest(&clear)), text(&vector, "clearSha256"), "{name}");
+        }
+    }
+
+    #[test]
+    fn upstream_example_is_the_secret() {
+        let vector = vectors().into_iter().find(|v| v["name"] == "upstream-example").expect("example");
+        let clear = attachment_decrypt(hex(text(&vector, "ciphertextHex")), info_of(&vector)).expect("decrypt");
+        assert_eq!(clear, b"It's a secret to everybody");
+    }
+
+    #[test]
+    fn an_altered_byte_of_any_vector_is_corrupted() {
+        for vector in vectors() {
+            let ciphertext = hex(text(&vector, "ciphertextHex"));
+            for index in [0, ciphertext.len() / 2, ciphertext.len() - 1] {
+                let mut altered = ciphertext.clone();
+                altered[index] ^= 1;
+                assert_eq!(
+                    attachment_decrypt(altered, info_of(&vector)),
+                    Err(AttachmentError::Corrupted),
+                    "{} byte {index}",
+                    text(&vector, "name"),
+                );
+            }
+            // Truncated or longer: the hash no longer matches.
+            let short = ciphertext[..ciphertext.len() - 1].to_vec();
+            assert_eq!(attachment_decrypt(short, info_of(&vector)), Err(AttachmentError::Corrupted));
+            let mut long = ciphertext.clone();
+            long.push(0);
+            assert_eq!(attachment_decrypt(long, info_of(&vector)), Err(AttachmentError::Corrupted));
+        }
+    }
+
+    // ---- Encryption ----
+
+    #[test]
+    fn encrypts_with_a_fresh_key_and_round_trips() {
+        let clear: Vec<u8> = (0..10_000u32).map(|i| (i * 31 + 7) as u8).collect();
+        let a = attachment_encrypt(clear.clone()).expect("encrypt");
+        let b = attachment_encrypt(clear.clone()).expect("encrypt");
+        assert_eq!(a.encrypted_data.len(), clear.len());
+        assert_ne!(a.encrypted_data, clear);
+        assert_ne!(a.encrypted_data, b.encrypted_data);
+        let info: Value = serde_json::from_str(&a.media_encryption_info).expect("info JSON");
+        let other: Value = serde_json::from_str(&b.media_encryption_info).expect("info JSON");
+        assert_ne!(info["key"]["k"], other["key"]["k"]);
+        assert_ne!(info["iv"], other["iv"]);
+        assert_eq!(info["v"], "v2");
+        assert_eq!(info["key"]["kty"], "oct");
+        assert_eq!(info["key"]["alg"], "A256CTR");
+        assert_eq!(info["key"]["ext"], true);
+        assert_eq!(info["key"]["key_ops"], serde_json::json!(["decrypt", "encrypt"]));
+        let iv = base64_decode(info["iv"].as_str().expect("iv")).expect("iv base64");
+        assert_eq!(iv.len(), 16);
+        assert_eq!(&iv[8..], &[0u8; 8], "the counter half starts at zero");
+        assert_eq!(text(&info["hashes"], "sha256"), base64_encode(Sha256::digest(&a.encrypted_data)));
+        let object = info.as_object().expect("object");
+        let mut keys: Vec<&str> = object.keys().map(String::as_str).collect();
+        keys.sort_unstable();
+        assert_eq!(keys, ["hashes", "iv", "key", "v"], "no url, nothing else");
+        assert_eq!(attachment_decrypt(a.encrypted_data, a.media_encryption_info).expect("decrypt"), clear);
+    }
+
+    #[test]
+    fn bounds_of_the_data() {
+        assert_eq!(attachment_encrypt(Vec::new()).err(), Some(AttachmentError::Input));
+        assert_eq!(attachment_encrypt(vec![0; MAX_ATTACHMENT_BYTES + 1]).err(), Some(AttachmentError::Input));
+        let largest = attachment_encrypt(vec![7; MAX_ATTACHMENT_BYTES]).expect("largest");
+        assert_eq!(largest.encrypted_data.len(), MAX_ATTACHMENT_BYTES);
+        let all = vectors();
+        let vector = &all[1];
+        assert_eq!(attachment_decrypt(Vec::new(), info_of(vector)), Err(AttachmentError::Input));
+        assert_eq!(
+            attachment_decrypt(vec![0; MAX_ATTACHMENT_BYTES + 1], info_of(vector)),
+            Err(AttachmentError::Input),
+        );
+    }
+
+    // ---- Media encryption info refused ----
+
+    #[test]
+    fn refuses_an_info_that_does_not_read() {
+        let all = vectors();
+        let vector = &all[1];
+        let ciphertext = hex(text(vector, "ciphertextHex"));
+        let base = vector["mediaEncryptionInfo"].clone();
+        let mut cases: Vec<String> = vec![
+            String::new(),
+            "not json".to_owned(),
+            "[]".to_owned(),
+            "x".repeat(MAX_INFO_BYTES + 1),
+        ];
+        let mut edit = |change: &dyn Fn(&mut Value)| {
+            let mut value = base.clone();
+            change(&mut value);
+            cases.push(serde_json::to_string(&value).expect("case"));
+        };
+        // v1 (IV never checked) and any other version: refused by the library (UnknownVersion).
+        edit(&|v| v["v"] = Value::from("v1"));
+        edit(&|v| v["v"] = Value::from("v3"));
+        edit(&|v| {
+            v.as_object_mut().expect("object").remove("hashes");
+        });
+        edit(&|v| v["hashes"] = serde_json::json!({}));
+        edit(&|v| v["key"]["k"] = Value::from("AAAA"));
+        edit(&|v| v["iv"] = Value::from("AAAA"));
+        edit(&|v| {
+            v.as_object_mut().expect("object").remove("key");
+        });
+        for case in cases {
+            assert_eq!(
+                attachment_decrypt(ciphertext.clone(), case.clone()),
+                Err(AttachmentError::Info),
+                "{case:.80}",
+            );
+        }
+        // Another key or IV of the right size: the hash still matches the ciphertext (it is the
+        // hash of the ciphertext), so the clear differs; the app checks the SHA-256 of the clear
+        // (plainSha256), as on the web.
+        let mut other = base.clone();
+        other["key"]["k"] = Value::from("Voq2nkPme_x8no5-Tjq_laDAdxE6iDbxnlQXxwFPgE4");
+        let clear = attachment_decrypt(ciphertext, serde_json::to_string(&other).expect("other")).expect("decrypt");
+        assert_ne!(to_hex(&clear), text(vector, "clearHex"));
+    }
+
+    // ---- Exported surface ----
+
+    /// Exactly two exported functions in this file, with these signatures.
+    #[test]
+    fn exported_surface_is_the_closed_list() {
+        let source = include_str!("attachments.rs");
+        let production = &source[..source.find("#[cfg(test)]").expect("tests")];
+        let exported: Vec<String> = production
+            .split("#[matrix_sdk_ffi_macros::export]")
+            .skip(1)
+            .map(|rest| {
+                let signature = &rest[..rest.find('{').expect("body")];
+                signature.split_whitespace().collect::<Vec<_>>().join(" ")
+            })
+            .collect();
+        assert_eq!(
+            exported,
+            vec![
+                "pub fn attachment_encrypt(data: Vec<u8>) -> Result<EncryptedAttachment, AttachmentError>",
+                "pub fn attachment_decrypt( encrypted_data: Vec<u8>, media_encryption_info: String, ) -> Result<Vec<u8>, AttachmentError>",
+            ]
+        );
+        assert!(!production.contains("uniffi::export"), "export through the crate's macro only");
+    }
+}
